#include <bits/stdc++.h>
using namespace std;
class Solution {
public:
    int maxArea(vector<int>& height) {
        int st=0;
        int end=height.size()-1;
        int ans=0;
        while (st<end){
            int width=end-st;
            int h=min(height[st], height [end]);
            int area =width *h ;
            ans=max(ans,area);
            
        
        if(height[st]<height [end]){
            st++;
        }
        else{
            end--;
        }
        }
        return ans;
    }
}; 